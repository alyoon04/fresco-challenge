# Copy to .env and fill in values before running:
#   docker compose -f docker-compose.prod.yml up -d

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Domain (Caddy auto-HTTPS) ---
# Set to your domain for automatic TLS, or leave as localhost for local testing.
DOMAIN=localhost

# --- Optional overrides ---
# POSTGRES_USER=fresco
# POSTGRES_DB=fresco
